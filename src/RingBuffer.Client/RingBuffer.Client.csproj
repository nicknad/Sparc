<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net11.0</TargetFrameworks>
    <RootNamespace>RingBuffer.Client</RootNamespace>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Description>Reusable producer/consumer sessions for the SPSC ring buffer: message framing, sequence/corruption verification, timeouts, structured stop reasons and one-way latency diagnostics. No console or process coupling.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RingBuffer.Core\RingBuffer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
  </ItemGroup>

</Project>

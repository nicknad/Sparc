<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net11.0</TargetFrameworks>
    <RootNamespace>Sparc.Testing</RootNamespace>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Description>Test harness for SPARC: paired in-memory endpoints, typed test channels, deterministic time via FakeTimeProvider and timeout helpers for async reads and writes.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sparc.Abstractions\Sparc.Abstractions.csproj" />
    <ProjectReference Include="..\Sparc.Channels\Sparc.Channels.csproj" />
    <ProjectReference Include="..\Sparc.Client\Sparc.Client.csproj" />
    <ProjectReference Include="..\Sparc.Core\Sparc.Core.csproj" />
    <ProjectReference Include="..\Sparc.InMemory\Sparc.InMemory.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.1.0" />
  </ItemGroup>

</Project>

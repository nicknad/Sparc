<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>Sparc.Client</RootNamespace>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Description>Reusable producer/consumer sessions for the SPSC ring buffer: message framing, sequence/corruption verification, timeouts, structured stop reasons and one-way latency diagnostics. No console or process coupling.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sparc.Core\Sparc.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sparc.Hosting" />
  </ItemGroup>

</Project>

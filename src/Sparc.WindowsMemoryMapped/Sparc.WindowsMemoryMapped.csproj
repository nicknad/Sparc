<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>Sparc.WindowsMemoryMapped</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Description>Windows named memory-mapped section implementation of IIpcMemoryRegionFactory with optional DACL-based section security (WindowsSectionSecurity), unnamed-section HANDLE-transfer capability mode, and AddWindowsNamedMemoryMappedIpc() dependency injection registration.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sparc.Abstractions\Sparc.Abstractions.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net11.0</TargetFrameworks>
    <RootNamespace>Sparc.Core</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Description>Lock-free single-producer/single-consumer ring buffer with explicit acquire/release ordering: a managed-array implementation and a cross-process implementation over IIpcMemoryRegion.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sparc.Abstractions\Sparc.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sparc.UnitTests" />
    <InternalsVisibleTo Include="Sparc.ConcurrencyTests" />
    <InternalsVisibleTo Include="Sparc.FuzzTests" />
    <InternalsVisibleTo Include="Sparc.Benchmarks" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RootNamespace>Sparc.UnixMemoryMapped</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Description>File-backed implementation of IIpcMemoryRegionFactory for Unix-like systems: one file per region mapped with MemoryMappedFile.CreateFromFile, unlinked by TryReset, including AddUnixFileMemoryMappedIpc() dependency injection registration.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sparc.Abstractions\Sparc.Abstractions.csproj" />
  </ItemGroup>

</Project>

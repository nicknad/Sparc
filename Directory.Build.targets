<Project>

  <!-- The repository README is shipped as the NuGet package readme. This must
       run after the project body so IsPackable is known. -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <!-- Packable projects lock their public surface; API changes must be
       reflected in PublicAPI.Shipped/Unshipped.txt. -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="3.3.4" PrivateAssets="all" />
  </ItemGroup>

</Project>

<Project>

  <!-- The repository README is shipped as the NuGet package readme. This must
       run after the project body so IsPackable is known. -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

</Project>
